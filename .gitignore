# Runtime state — never commit
state/
migrator/out/
home/.letta/lc-local-backend/
home/.letta/channels/*/state/
home/.letta/channels/*/media-cache/
home/.letta/channels/matrix/credentials/
home/.letta/credentials.json
home/.letta/settings.json
home/.letta/cache/
home/.letta/logs/
home/.letta/projects/
home/.letta/transcripts/
home/.letta/remote-settings.json
home/.letta/crons.json
home/crons.json

# letta-code project metadata — local to each clone, regenerated on use.
.letta/.lettaignore
.letta/settings.local.json
**/.letta/settings.local.json
**/.letta/.lettaignore

# Local env file — copy env.example.sh to env.sh and edit.
env.sh

# Secrets — accounts.json contains real channel tokens.
# Ship the .example versions instead.
home/.letta/channels/*/accounts.json
!home/.letta/channels/*/accounts.example.json

# Migrator export data (agent dumps may contain prompts/keys)
migrator/data/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
admin-shim/test/fixtures/stream-traces/*.stderr
