# Runtime state — never commit
state/
migrator/out/
home/.letta/lc-local-backend/
home/.letta/channels/*/state/
home/.letta/channels/*/media-cache/
home/.letta/channels/matrix/credentials/
home/.letta/credentials.json
home/.letta/settings.json
home/.letta/cache/
home/.letta/logs/
home/.npm/
home/.letta/projects/
home/.letta/transcripts/
home/.letta/remote-settings.json
home/.letta/.bootstrapped
home/.letta/crons.json
home/crons.json

# Per-machine user home pollution when the shim runs with HOME=./home.
# These directories belong to whichever runtime tools we shell out to
# (bun, node, git config) and should never be checked in.
home/.bun/
home/.cache/
home/.config/
home/.gitconfig

# Beads per-machine sync state (the dir form is already in .beads/.gitignore,
# but the JSON file alias slips through at the workspace level).
.beads/export-state.json

# letta-code project metadata — local to each clone, regenerated on use.
.letta/.lettaignore
.letta/settings.local.json
**/.letta/settings.local.json
**/.letta/.lettaignore

# Local env file — copy env.example.sh to env.sh and edit.
env.sh

# Secrets — accounts.json contains real channel tokens.
# Ship the .example versions instead.
home/.letta/channels/*/accounts.json
!home/.letta/channels/*/accounts.example.json

# Migrator export data (agent dumps may contain prompts/keys)
migrator/data/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build output
admin-shim/dist/
admin-shim/*.tsbuildinfo

# Logs
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
admin-shim/test/fixtures/stream-traces/*.stderr

# letta-code session state at repo root
/.letta/
