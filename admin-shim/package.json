{
  "name": "letta-code-admin-shim",
  "version": "0.3.0",
  "private": true,
  "description": "HTTP shim exposing a Letta-server-compatible REST surface on top of letta-code's LocalBackend. Also hosts the mobile channel WS endpoint.",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "node --import tsx/esm server.ts",
    "dev": "tsx watch server.ts",
    "test": "node --import tsx/esm --test --test-concurrency=1 --test-reporter=spec test/*.test.mjs",
    "test:watch": "node --import tsx/esm --test --test-concurrency=1 --watch test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "echo 'not yet — phase 6' && exit 0"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
